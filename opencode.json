{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "small_model": "openrouter/openai/gpt-5.6-luna",
  "agent": {
    "build": {
      "tools": {
      },
      "compaction": {
      }
    },
    "plan": {
      "compaction": {
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "high"
      }
    }
  },
  "lsp": {

  },
  "mcp": {
     "agentis": {
      "type": "remote",
      "url": "https://agentis.cz/mcp",
      "headers": {
        "Authorization": "Bearer {env:AGENTIS_TOKEN}"
      }
    },
     "ask-question": {
      "command": ["/var/www/agentis-sdk/.venv/bin/python", "-m", "agentis_sdk.mcp_server"],
      "cwd": "/var/www/agentis-sdk",
      "type": "local",
      "environment": {
        "PYTHONPATH": "/var/www/agentis-sdk",
        "AGENTIS_API_URL": "https://agentis.cz/api",
        "AGENTIS_API_TOKEN": "{env:AGENTIS_TOKEN}"
      }
    }
  },
  "experimental": {
    "mcp_timeout": 3600000
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
           "options": {
              "reasoningEffort": "high",
              "textVerbosity": "medium",
              "reasoningSummary": "detailed"
            }
        }
      }
    }
  }
}